rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNÇÕES AUXILIARES ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- REGRAS DE COLEÇÃO ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      // Bloqueia a criação de usuários já com cargo de admin pelo client
      allow create: if isOwner(userId) && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role != 'admin');
      
      // Impede que o usuário mude seu próprio cargo ou adicione XP infinito via client
      allow update: if isAdmin() || (
        isOwner(userId) && 
        (!request.resource.data.keys().hasAny(['role'])) && 
        (request.resource.data.xp <= resource.data.xp + 200) // Proteção básica contra hack de XP
      );
      
      allow delete: if isAdmin();
    }

    // VULNERABILIDADE CRÍTICA CORRIGIDA: Ninguém pode se dar permissão de Admin pelo client.
    match /roles_admin/{adminUid} {
      allow get: if isSignedIn();
      allow create, update, delete: if false; // APENAS VIA CONSOLE DO FIREBASE OU BACKEND
      allow list: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /questions/{questionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId}/history/{historyId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if false; // Histórico é imutável
    }

    match /users/{userId}/notes/{noteId} {
      allow get, list: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    match /users/{userId}/progress/main {
      allow get: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }
    
    match /settings/{settingId} {
      allow get: if isSignedIn();
      allow write: if isAdmin();
    }

    match /system_logs/{logId} {
      allow get, list, create: if isAdmin();
    }
  }
}
